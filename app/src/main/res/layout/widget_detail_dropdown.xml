<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/widgetName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="app Name"
        android:layout_marginBottom="12dp"
        android:textSize="25sp" />
    <com.ndds.homelauncher.widgets.ModalItem
        android:id="@+id/removeWidget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/info"
        app:label="Remove Widget"
        />
    <com.ndds.homelauncher.widgets.ModalItem
        android:id="@+id/changeWidget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:icon="@drawable/pin"
        app:label="Change Widget"
        />
</LinearLayout>